# Copy to .env and fill in. Never commit .env.

# Sarvam: voice (Bulbul TTS, Saaras STT), reading scans (Sarvam Vision), and Sarvam text models
SARVAM_API_KEY=

# Gemini: writes the text explanations when set (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (default; gemini-3.5-flash is a bit faster)

# Optional: force the default text provider: sarvam | gemini | openai | anthropic | openrouter
# TEXT_PROVIDER=gemini
# Optional server keys for other providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional: default Bulbul voice: shubh | ritu | priya | simran | kavya | aditya | rahul | anand
# SARVAM_TTS_VOICE=ritu
